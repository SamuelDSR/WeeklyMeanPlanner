# 本地直接跑 `npm run dev`（不经过 docker）时用这份配置
# 复制成 .env，改一下连接串指向你本地装的 Postgres

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mealplanner
JWT_SECRET=dev_only_secret_change_in_production
NODE_ENV=development
PORT=3000
# 本地没有 https，cookie 的 secure 标志设成 false，不然浏览器不会保存 cookie
COOKIE_SECURE=false
# 前端 dev server 的地址（用于 CORS 白名单）
DEV_FRONTEND_ORIGIN=http://localhost:5173
