# 复制这个文件为 .env，然后改成你自己的值
# docker compose 会自动读取同目录下的 .env

# Postgres 密码，随便设置一个强密码
POSTGRES_PASSWORD=change_me_to_a_strong_password

# JWT 签名密钥，随便设置一串足够长的随机字符串，比如执行：
#   openssl rand -base64 32
JWT_SECRET=change_me_to_a_random_string

# 管理员账号邮箱：用这个邮箱注册时会自动成为管理员，并直接通过审核，
# 其他人注册后都要在后台"账号管理"里由管理员点通过才能登录。
# 留空的话，第一个注册的账号自动成为管理员。
ADMIN_EMAIL=you@example.com

# cookie 的 secure 标志。默认 true，适用于"浏览器 --https--> nginx --http--> 容器"的正式部署。
# 只有在想绕过 nginx、直接用 http://<服务器IP>:8080 调试时才改成 false（Safari 直连本机也需要）。
# COOKIE_SECURE=false

# 做饭提醒用的 VAPID 密钥（可选）。留空的话服务端会自动生成一对存进数据库，
# 重启也不会变。想自己指定就填这三个：
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# 8080 端口绑在哪个网卡上：
#   127.0.0.1   只给本机（默认，前面有 nginx 反代时用这个）
#   0.0.0.0     所有网卡，局域网里手机/电脑可以直接连 http://<这台机器的IP>:8080
#   192.168.1.50 只给某一个网卡
# 注意：用非 127.0.0.1 的方式从手机访问时，还要把 COOKIE_SECURE 设成 false，
# 否则登录不上（浏览器只对 localhost 破例允许 Secure cookie 走 http）。
# BIND_ADDR=0.0.0.0
